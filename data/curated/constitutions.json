    {
      "id": "fr_1875",
      "title_zh": "1875年宪法性法律",
      "title_orig": "Lois constitutionnelles de 1875",
      "kind": "formal",
      "adopted": null,
      "promulgated": "1875-02-25",
      "effective": "1875-02-25",
      "repealed": null,
      "summary_zh": "第三共和国没有一部单一宪法典，而是1875年2月24日、2月25日和7月16日三部宪法性法律。本图从2月25日起把这一组视为在行文本，2月24日当天不显示整组。7月10日的宪法性法律只是授权起草新宪法，没有在当天废止这三部法律。7月11日的宪法性法令第1号废止了2月25日法律的第2条，第2号废止了与该法令抵触的条文。本图从7月11日起不再把这三部法律整组写成仍完整在行，也没有逐条标出还剩下哪些。巴黎若点到占领区，不套这三部法律。",
      "sources": [
        {"label": "法国宪法委员会：历史上的宪法", "url": "https://www.conseil-constitutionnel.fr/rubrique-principale/les-constitutions-dans-l-histoire"}
      ],
      "spans": [
        {"qid": "Q70802", "from": "1875-02-25", "until": "1940-07-10"},
        {"qid": "Q69808", "from": "1940-06-25", "until": "1940-07-11"}
      ]
    },
    {
      "id": "fr_vichy_1940_07_10",
      "title_zh": "1940年7月10日宪法性法律",
      "title_orig": "Loi constitutionnelle du 10 juillet 1940",
      "kind": "pending",
      "adopted": "1940-07-10",
      "promulgated": "1940-07-10",
      "effective": "1940-07-10",
      "repealed": null,
      "summary_zh": "国民议会把起草新宪法的权力交给贝当署名下的政府。它要求新宪法保障劳动、家庭和祖国的权利，并由国家批准、由它设立的议会实施。这不是那部新宪法本身，新宪法后来没有按这条颁成。维基文库所转《官方公报》的日期是7月11日，文本落款是7月10日。法国参议院记述当天投票、次日才颁布宪法性法令。1944年8月9日法令第3条点名宣布它无效；第11条写明该法令在大陆随解放适用。这两天都不是维希多边形的结束日。类型待考。只挂在维希政权上。",
      "sources": [
        {"label": "维基文库所转1940年7月11日官方公报上的7月10日宪法性法律", "url": "https://fr.wikisource.org/wiki/Loi_constitutionnelle_du_10_juillet_1940"},
        {"label": "法国参议院：7月10日投票，7月11日颁布宪法性法令", "url": "https://www.senat.fr/connaitre-le-senat/lhistoire-du-senat/dossiers-dhistoire/d38/le-senat-de-1940-a-1944-de-vichy-a-chatelguyon.html"},
        {"label": "法国政府法律网站：1944年8月9日法令第3条、第11条", "url": "https://www.legifrance.gouv.fr/loda/id/JORFTEXT000000320215"}
      ],
      "spans": [{"qid": "Q69808", "from": "1940-07-10", "until": null}],
      "phases": [
        {"from": "1940-07-10", "until": "1944-08-09", "force_zh": "维希政权的授权依据，不是新宪法", "force_note": "形式地位是宪法性法律。它授权颁布新宪法，本身不是那部宪法。"},
        {"from": "1944-08-09", "until": null, "force_zh": "已被1944年8月9日法令宣布无效", "force_note": "第3条点名宣布无效。第11条写明该法令在大陆领土上随解放适用。这不是把政权切换日当成废止日。"}
      ]
    },
    {
      "id": "fr_vichy_1940_07_11",
      "title_zh": "1940年7月11日宪法性法令",
      "title_orig": "Actes constitutionnels des 11 juillet 1940",
      "kind": "pending",
      "adopted": null,
      "promulgated": "1940-07-11",
      "effective": "1940-07-11",
      "repealed": null,
      "summary_zh": "第1、2、3号都落款7月11日，法国政府法律网站记《官方公报》为7月12日。第1号写明贝当担任国家元首，并废止1875年2月25日法律第2条。第2号规定国家元首的权力，并废止1875年三部法律中与该法令抵触的规定。第3号让议会休会。它们和第10日的授权法律不是同一件事。1944年8月9日法令第3条宣布所有称为宪法性法令的文本无效，适用方式见该法令第11条。类型待考。只挂在维希政权上。",
      "sources": [
        {"label": "法国政府法律网站：7月11日宪法性法令第1号，公报7月12日", "url": "https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000000476688"},
        {"label": "法国政府法律网站：第2号", "url": "https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000000671775"},
        {"label": "法国政府法律网站：第3号", "url": "https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000000476689"},
        {"label": "法国政府法律网站：1944年8月9日法令", "url": "https://www.legifrance.gouv.fr/loda/id/JORFTEXT000000320215"}
      ],
      "spans": [{"qid": "Q69808", "from": "1940-07-11", "until": null}],
      "phases": [
        {"from": "1940-07-11", "until": "1944-08-09", "force_zh": "维希政权当日颁布的宪法性法令", "force_note": "与7月10日的授权法律分开。不是一部已经颁成的新宪法。"},
        {"from": "1944-08-09", "until": null, "force_zh": "已被1944年8月9日法令宣布无效", "force_note": "第3条宣布所有称为宪法性法令的文本无效。第11条写明大陆上随解放适用。"}
      ]
    },
