    {
      "id": "cn_1949",
      "title_zh": "1949年共同纲领",
      "title_orig": "中国人民政治协商会议共同纲领",
      "kind": "provisional",
      "adopted": "1949-09-29",
      "promulgated": "1949-09-29",
      "effective": "1949-10-01",
      "repealed": "1954-09-20",
      "summary_zh": "中国人民政治协商会议第一届全体会议1949年9月29日通过。全国人大沿革说明：10月1日中央人民政府委员会接受它为施政方针，在1954年宪法以前起临时宪法的作用。类型是临时宪法/约法，不是后来的宪法。只挂在中华人民共和国上。9月29日北京点到的不是这个政权。中华民国不套用。",
      "sources": [
        {"label": "中国人大网：宪法沿革", "url": "http://www.npc.gov.cn/npc/c12434/dzlfxzgcl70nlflc/202108/t20210824_313204.html"}
      ],
      "spans": [{"qid": "Q148", "from": "1949-10-01", "until": "1954-09-20"}]
    },
