    {
      "id": "de_weimar",
      "title_zh": "魏玛宪法",
      "title_orig": "Die Verfassung des Deutschen Reichs",
      "kind": "formal",
      "adopted": "1919-07-31",
      "promulgated": "1919-08-11",
      "effective": "1919-08-14",
      "repealed": null,
      "summary_zh": "国民议会1919年7月31日通过，总统8月11日签署。第181条规定自公布之日起生效，德国历史文献写明签署后三日、即8月14日生效。1933年3月24日的授权法没有写明废止这部宪法，第2条只允许政府制定的法律偏离它。欧洲委员会威尼斯委员会的说明写：1933至1945年这部宪法在纸面上没有被正式废止。基本法第140条把1919年8月11日宪法的若干条文收为基本法的一部分。所以本图在纳粹德国期间仍列出它，并分开写效力：不是把它说成当时仍按原文正常实施，也不把授权法写成一部新宪法。本批不自定一个废止日。",
      "sources": [
        {"label": "德国历史文献：魏玛宪法，签署后三日生效", "url": "https://germanhistorydocs.org/en/weimar-germany-1918-1933/the-weimar-constitution-august-11-1919"},
        {"label": "伯尔尼大学：1933年3月24日授权法原文", "url": "https://www.servat.unibe.ch/dns/RGBl_1933_I_141_G_Behebung_Not.html"},
        {"label": "威尼斯委员会：魏玛宪法在1933至1945年没有被正式废止", "url": "https://docs-venice.coe.int/files/Bicameralism/GER-E.htm"},
        {"label": "基本法第140条：收进1919年8月11日宪法的若干条文", "url": "https://www.gesetze-im-internet.de/gg/art_140.html"}
      ],
      "spans": [
        {"qid": "Q41304", "from": "1919-08-14", "until": "1933-01-30"},
        {"qid": "Q7318", "from": "1933-01-30", "until": null}
      ],
      "phases": [
        {"from": "1919-08-14", "until": "1933-02-28", "force_zh": "形式在行", "force_note": "这一段还没有2月28日的停止基本权利的命令，也没有3月24日的授权法。"},
        {"from": "1933-02-28", "until": "1933-03-24", "force_zh": "形式未废止，列出的基本权利已停止", "force_note": "2月28日的命令依据第48条第2款，把列出的条文在另行通知前停止效力。整部宪法没有因此废止。"},
        {"from": "1933-03-24", "until": null, "force_zh": "形式未废止，实际被架空", "force_note": "授权法第2条允许偏离宪法，没有废止宪法。不能把这一天之后写成宪法已经废止，也不能写成仍按原文正常实施。"}
      ]
    },
    {
